    print(f"{'─'*60}")
    print(f"  Cohesivo  : {score_coh:.1f}")
    print(f"  Moderado  : {score_mod:.1f}")
    print(f"  Mezclado  : {score_mix:.1f}")
    diff = score_coh - score_mix
